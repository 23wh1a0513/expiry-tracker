            // Specific storage tips
            if (msg.includes('store') || msg.includes('keep')) {
                const storageGuides = {
                    'bread': '🍞 Store bread:\n- Keep in a bread box or paper bag at room temperature\n- Avoid refrigerator (dries it out)\n- For longer storage, freeze in airtight container\n- Can last 3-5 days at room temperature, weeks if frozen',
                    'cheese': '🧀 Store cheese:\n- Wrap tightly in parchment or wax paper, then plastic wrap\n- Keep in cheese drawer (coldest part of fridge)\n- Soft cheeses last 1-2 weeks\n- Hard cheeses last several weeks\n- Check for mold before eating',
                    'milk': '🥛 Store milk:\n- Keep in main refrigerator section (not door)\n- Door is warmer due to opening/closing\n- Use within 5-7 days of opening\n- Check smell and appearance for spoilage\n- Unopened milk lasts longer',
                    'vegetable': '🥬 Store vegetables:\n- Most go in crisper drawer of fridge\n- Keep humidity moderate (not too dry, not too wet)\n- Store separately if possible to prevent ethylene damage\n- Check regularly for wilting or decay',
                    'herb': '🌿 Store herbs:\n- Fresh: Store in damp paper towel in fridge\n- Or place stems in water like flowers\n- Dried: Keep in cool, dark, dry place\n- Use within 1-2 months for best flavor',
                    'meat': '🍗 Store meat:\n- Keep in coldest part of fridge\n- Use within 1-2 days of purchase\n- For longer storage, freeze immediately\n- Thaw in fridge, not at room temperature',
                    'fruit': '🍎 Store fruit:\n- Most fruits go in crisper drawer\n- Keep separate from vegetables\n- Citrus can be stored at room temperature\n- Bananas separate from other fruits to slow ripening',
                    'sugar': '🍯 Store sugar:\n- Keep in cool, dry place in airtight container\n- Brown sugar: store with moisture shield (bread piece) to prevent hardening\n- Avoid humid areas (kitchen near sink)\n- Lasts indefinitely if kept dry\n- Powdered sugar: prone to caking, use airtight container',
                    'flour': '🌾 Store flour:\n- Keep in cool, dry place or refrigerator\n- Store in airtight container to prevent bugs and moisture\n- Room temperature: lasts 6-8 months\n- Refrigerator: lasts up to 1 year\n- Freezer: lasts indefinitely',
                    'rice': '🍚 Store rice:\n- Keep in sealed container in cool, dry place\n- White rice: lasts indefinitely\n- Brown rice: lasts 6-8 months (goes rancid faster due to oil)\n- Store away from pests\n- Can be frozen for extended storage',
                    'pasta': '🍝 Store pasta:\n- Keep in cool, dry place in original box or airtight container\n- Unopened: lasts 2+ years\n- Cooked pasta: refrigerate 3-5 days in airtight container\n- Freeze cooked pasta up to 2 months',
                    'oil': '🛢️ Store oil:\n- Keep in cool, dark place away from heat and light\n- Olive oil: best within 2 years, refrigerate if opened during hot weather\n- Vegetable oil: lasts 1-2 years\n- Avoid sunlight to prevent oxidation',
                    'spices': '🧂 Store spices:\n- Keep in cool, dry place in airtight containers\n- Away from heat, light, and moisture\n- Last 1-2 years for maximum flavor\n- Store away from stove (heat causes flavor loss)',
                    'eggs': '🥚 Store eggs:\n- Keep in original carton in refrigerator (not door)\n- Pointed end down to keep yolk centered\n- Last 3-5 weeks from purchase date\n- Check for cracks before using',
                    'yogurt': '🥛 Store yogurt:\n- Keep refrigerated at 40°F or below\n- Use within 1-2 weeks of opening\n- Check date on container\n- Don\'t store in door (temperature fluctuates)',
                    'butter': '🧈 Store butter:\n- Refrigerator: lasts 1-3 months\n- Freezer: lasts up to 6 months\n- Keep in original wrapper or airtight container\n- Away from strong odors',
                    'leftovers': '🍲 Store leftovers:\n- Refrigerate within 2 hours of cooking\n- Use within 3-4 days\n- Store in airtight containers\n- Label with date for tracking',
                    'nuts': '🥜 Store nuts:\n- Cool, dry place in airtight container\n- Refrigerator: lasts 6-9 months\n- Freezer: lasts 1-2 years\n- Protect from light and moisture'
                };

                const query = msg.toLowerCase();

