                // If no exact match, try to extract item name and provide general advice
                const storePatterns = [
                    /how to store (.+)/i,
                    /how do i store (.+)/i,
                    /store (.+) how/i,
                    /keep (.+) fresh/i,
                    /(.+) storage/i
                ];

                let itemName = null;
                for (const pattern of storePatterns) {
