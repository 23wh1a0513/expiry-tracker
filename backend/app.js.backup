                        return res.json({ reply: `🍖 Store ${itemName}:\n- Keep in coldest part of refrigerator\n- Use within 1-2 days of purchase\n- Freeze immediately for longer storage\n- Thaw in refrigerator, never at room temperature\n- Store raw meat below ready-to-eat foods` });
                    }

