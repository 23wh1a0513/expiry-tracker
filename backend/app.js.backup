        }
        
        // intent: cooking tips and questions
        if (msg.includes('how do i') || msg.includes('tips') || msg.includes('advice') || msg.includes('cooking')) {
            if (msg.includes('boil') || msg.includes('boiling')) {
                return res.json({ reply: `Boiling tips:\n- Use plenty of water (about 4 cups per cup of pasta/rice)\n- Add salt after water boils\n- Stir occasionally to prevent sticking\n- Test doneness frequently\n- Drain immediately when done` });
            }
            
            if (msg.includes('bake') || msg.includes('baking')) {
                return res.json({ reply: `Baking tips:\n- Preheat oven fully before putting food in\n- Use oven mitts - handles get hot!\n- Center rack is usually best for even baking\n- Rotate pans halfway through for even results\n- Use a timer and check a few minutes early` });
            }
            
            if (msg.includes('fry') || msg.includes('frying')) {
                return res.json({ reply: `Frying tips:\n- Heat oil to proper temperature (test with a drop of water - should sizzle)\n- Don't overcrowd the pan\n- Use tongs to flip/turn food\n- Drain on paper towels to remove excess oil\n- Season immediately after frying` });
            }
            
            if (msg.includes('season') || msg.includes('flavor')) {
                return res.json({ reply: `Seasoning tips:\n- Taste as you go - you can always add more\n- Salt enhances natural flavors\n- Acid (lemon, vinegar) brightens dishes\n- Herbs add freshness, spices add warmth\n- Start with less - you can always add more!` });
            }
            
            // Generic cooking response
            return res.json({ reply: `Cooking tips I can help with:\n- Boiling techniques\n- Baking advice\n- Frying tips\n- Seasoning and flavoring\n- General kitchen advice\n\nWhat cooking question do you have?` });
        }
        
        // intent: help or what can you do
        if (msg.includes('help') || msg.includes('what can you') || msg.includes('commands') || msg.includes('?')) {
            return res.json({ reply: "I can help you with:\n- 📦 Inventory management (list items, add items, expiring items)\n- 📅 Consumption planning and scheduling\n- 🧾 Risk assessment for products\n- 🍳 Recipes using your expiring items\n- 🍽️ Meal planning based on your inventory\n- 🛒 Grocery shopping advice and tips\n- 🥗 Healthy eating and snack suggestions\n- 🔄 Ingredient substitutes\n- 🗄️ Food storage tips\n- 👨‍🍳 Cooking techniques and tips\n\nTry asking: 'what should I cook today?', 'give me a recipe', 'healthy snacks', 'how to boil pasta', or 'what should I buy'" });
        }
        
        // intent: general grocery questions
        if (msg.includes('where') || msg.includes('store') || msg.includes('shop') || msg.includes('market') || msg.includes('supermarket')) {
            if (msg.includes('where') && (msg.includes('buy') || msg.includes('find') || msg.includes('get'))) {
                return res.json({ reply: `I don't have specific store information, but most grocery stores carry:\n- Fresh produce in the produce section\n- Dairy products in the dairy aisle\n- Meat and seafood in the meat department\n- Pantry staples in the center aisles\n- Frozen items in the freezer section\n\nCheck your local grocery store or use store apps for specific locations!` });
            }
        }
        
        if (msg.includes('price') || msg.includes('cost') || msg.includes('expensive') || msg.includes('cheap')) {
            return res.json({ reply: `Grocery pricing tips:\n- Buy generic/store brands to save money\n- Shop sales and use coupons\n- Buy in bulk for staples you use often\n- Consider seasonal produce (cheaper and fresher)\n- Plan meals around sales items\n- Use a shopping app to compare prices\n\nRemember: quality and freshness are more important than the lowest price!` });
        }
        
        if (msg.includes('organic') || msg.includes('natural') || msg.includes('fresh')) {
            return res.json({ reply: `Fresh vs. organic considerations:\n- Organic: Grown without synthetic pesticides, often more expensive\n- Local/fresh: Often better taste and nutrition, supports local farmers\n- Conventional: Usually cheaper, still safe and nutritious\n- Frozen: Can be just as nutritious as fresh, often cheaper\n- Canned: Long shelf life, convenient, still healthy in moderation\n\nChoose based on your budget, availability, and preferences!` });
        }
        
        if (msg.includes('allergen') || msg.includes('allergy') || msg.includes('gluten') || msg.includes('dairy') || msg.includes('nut')) {
            return res.json({ reply: `Allergen awareness tips:\n- Always read ingredient labels carefully\n- Look for allergen warnings on packaging\n- Common allergens: nuts, dairy, eggs, soy, wheat, shellfish\n- Cross-contamination can occur in processing\n- When dining out, ask about ingredients and preparation\n- Consider allergen-free alternatives when shopping\n\nIf you have severe allergies, consult with a healthcare professional for guidance.` });
        }
        
        // default canned
        if (openai) {
            const aiReply = await generateOpenAIReply(message, userId);
            return res.json({ reply: aiReply });
        }

        return res.json({ reply: "I'm your Expiry Tracker assistant! I can help with inventory management, recipes, grocery advice, and cooking tips. Say 'help' for more options." });
    } catch (err) {
        console.error('Chat error', err);
        res.status(500).json({ reply: 'Error processing message' });
    }
});

// Helper function for chat risk assessment
async function fetchRisk(name, userId) {
    if (!name) return { risk: 'unknown', count: 0, avgDays: 0 };
    const regex = new RegExp(name.replace(/[.*+?^${}()|[\\]\\]/g, '\\$&'), 'i');
    const filter = userId ? { name: regex, owner: userId } : { name: regex };
    const items = await Item.find(filter);
    if (!items || items.length === 0) return { risk: 'unknown', count: 0, avgDays: 0 };
    const now = new Date();
    const stats = items.map(it => Math.ceil((new Date(it.expiryDate) - now) / (1000*60*60*24)));
    const avgDays = Math.round(stats.reduce((a,b)=>a+b,0)/stats.length);
    let risk = 'low';
    if (avgDays < 7) risk = 'high'; else if (avgDays < 21) risk = 'medium';
    return { risk, count: items.length, avgDays };
}

async function generateOpenAIReply(message, userId) {
    if (!openai) return "I'm your Expiry Tracker assistant! I can help with inventory management, recipes, grocery advice, and cooking tips.";

    const userItems = userId ? await Item.find({ owner: userId, expired: false }).limit(20) : [];
    const inventoryText = userItems.length
        ? `You have the following unexpired items in inventory:\n${userItems.slice(0, 15).map(i => `- ${i.name} (expires ${new Date(i.expiryDate).toLocaleDateString()})`).join('\n')}`
        : 'No items are currently in the inventory.';

    const systemPrompt = `You are an assistant for an expiry tracking app. Answer user questions clearly and be helpful. If the user asks about items, use the inventory context when possible. Provide simple kitchen/food advice, but avoid medical or legal advice.`;

    const userPrompt = `User message: "${message}"

${inventoryText}`;

    try {
        const completion = await openai.createChatCompletion({
            model: 'gpt-3.5-turbo',
            messages: [
                { role: 'system', content: systemPrompt },
                { role: 'user', content: userPrompt }
            ],
            max_tokens: 250,
            temperature: 0.7
        });
        const reply = completion.data?.choices?.[0]?.message?.content?.trim();
        if (reply) return reply;
    } catch (err) {
        console.error('OpenAI chat error', err);
    }

    return "I'm your Expiry Tracker assistant! I can help with inventory management, recipes, grocery advice, and cooking tips. Say 'help' for more options.";
}

// Scheduler: mark items expired if expiryDate < now
async function markExpiredItems() {
    try {
        const now = new Date();
        const res = await Item.updateMany({ expiryDate: { $lt: now }, expired: false }, { $set: { expired: true } });
        if (res && res.nModified) console.log(`Marked ${res.nModified} items as expired`);
    } catch (err) {
        console.error('Error marking expired items', err);
    }
}

// Run once on startup and then every 6 hours
mongoose.connection.once('open', () => {
    markExpiredItems();
    setInterval(markExpiredItems, 1000 * 60 * 60 * 6);
});

// Graceful shutdown (use disconnect Promise-compatible API)
const shutDown = () => {
    console.log('Shutting down server...');
    mongoose.disconnect()
        .then(() => {
            console.log('Mongo connection closed. Exiting process.');
            process.exit(0);
        })
        .catch((err) => {
            console.error('Error during mongoose disconnect:', err);
            process.exit(1);
        });
};

process.on('SIGINT', shutDown);
process.on('SIGTERM', shutDown);

app.listen(PORT, () => {
    console.log(`Server is running on http://localhost:${PORT}`);
});
