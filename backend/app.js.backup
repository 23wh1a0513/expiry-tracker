    if (!name) return { risk: 'unknown', count: 0, avgDays: 0 };
    const regex = new RegExp(name.replace(/[.*+?^${}()|[\\]\\]/g, '\\$&'), 'i');
    const filter = userId ? { name: regex, owner: userId } : { name: regex };
    const items = await Item.find(filter);
    if (!items || items.length === 0) return { risk: 'unknown', count: 0, avgDays: 0 };
    const now = new Date();
    const stats = items.map(it => Math.ceil((new Date(it.expiryDate) - now) / (1000*60*60*24)));
    const avgDays = Math.round(stats.reduce((a,b)=>a+b,0)/stats.length);
    let risk = 'low';
    if (avgDays < 7) risk = 'high'; else if (avgDays < 21) risk = 'medium';
    return { risk, count: items.length, avgDays };
}

async function generateOpenAIReply(message, userId) {\nIngredients:\n- 500g chicken breast\n- 1 onion, chopped\n- 2 carrots, sliced\n- 2 celery stalks, chopped\n- 1L chicken broth\n- Salt, pepper, herbs\n\nInstructions:\n1. Sauté vegetables in pot for 5 minutes\n2. Add chicken and broth, bring to boil\n3. Simmer 20-25 minutes until chicken is cooked\n4. Remove chicken, shred, return to pot\n5. Season and serve hot`,
                
                'salad': `Fresh Garden Salad:\nIngredients:\n- Mixed greens (lettuce, spinach)\n- 1 cucumber, sliced\n- 2 tomatoes, chopped\n- 1/2 red onion, thinly sliced\n- Olive oil and vinegar dressing\n- Salt and pepper\n\nInstructions:\n1. Wash and chop all vegetables\n2. Combine in large bowl\n3. Drizzle with olive oil and vinegar\n4. Season with salt and pepper\n5. Toss gently and serve`,
                
                'sandwich': `Classic Sandwich:\nIngredients:\n- 2 slices bread\n- Sliced deli meat or cheese\n- Lettuce, tomato, onion\n- Mayo or mustard\n- Salt and pepper\n\nInstructions:\n1. Spread mayo/mustard on bread\n2. Layer meat, cheese, vegetables\n3. Season lightly\n4. Top with second bread slice\n5. Cut in half and enjoy`,
                
                'omelette': `Basic Omelette:\nIngredients:\n- 2-3 eggs\n- 1 tbsp milk\n- Salt and pepper\n- 1 tbsp butter\n- Optional fillings: cheese, vegetables, ham\n\nInstructions:\n1. Whisk eggs with milk, salt, pepper\n2. Heat butter in pan over medium heat\n3. Pour in egg mixture\n4. Cook until edges set (2-3 minutes)\n5. Add fillings, fold and serve`
            };

            // If asking for a specific recipe, try to match it
            if (dish) {
                const dishLower = dish.toLowerCase();
                for (const [key, recipe] of Object.entries(recipes)) {
                    if (dishLower.includes(key)) {
                        return res.json({ reply: `Here's a simple ${key} recipe:\n\n${recipe}` });
