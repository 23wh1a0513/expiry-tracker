                    if (item.includes('flour') || item.includes('rice') || item.includes('pasta') || item.includes('cereal') || item.includes('bread') || item.includes('sugar') || item.includes('oat') || item.includes('quinoa') || item.includes('barley') || item.includes('bean') || item.includes('lentil') || item.includes('noodle')) {
                        return res.json({ reply: `🌾 Store ${itemName}:\n- Keep in cool, dry place in airtight containers\n- Away from heat, moisture, and pests\n- Pantry staples last 6-12 months\n- Check for bugs or moisture regularly\n- Refrigerate flour if you live in hot, humid climate` });
