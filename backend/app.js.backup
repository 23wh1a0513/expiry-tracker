                }

                return res.json({ reply: `General storage tips:\n- Produce goes in crisper drawer\n- Dairy in coldest part of fridge\n- Meat on bottom shelf\n- Keep raw meat away from ready-to-eat food\n- Check expiry dates regularly\n- Most shelf-stable items in cool, dry place\n\nI can provide specific storage advice for many items. What would you like to store?` });
