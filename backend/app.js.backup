                        return res.json({ reply: `🥬 Store ${itemName}:\n- Most fresh produce goes in crisper drawer\n- Keep fruits and vegetables separate (ethylene gas)\n- Some fruits (citrus, apples) can be stored at room temperature\n- Check regularly for spoilage\n- Wash just before eating, not before storing` });
                    }

